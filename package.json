{
  "name": "faithquest365",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:brand": "node scripts/build-brand.mjs",
    "build:public-site": "node scripts/build-public-site.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:edge": "npx --yes deno@2.9.6 check --frozen --config supabase/functions/delete-account/deno.json supabase/functions/delete-account/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:account": "playwright test --config=playwright.account.config.ts",
    "check": "npm run lint && npm run typecheck && npm run check:edge && npm test && npm run build",
    "format": "prettier --write src tests docs *.json *.mjs *.ts *.mts README.md",
    "format:check": "prettier --check src tests docs *.json *.mjs *.ts *.mts README.md",
    "db:migrate": "node scripts/db-migrate.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "health:check": "node scripts/check-services.mjs",
    "test:database": "vitest run tests/database",
    "test:database:live": "node scripts/verify-live-db.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postgres": "^3.4.9",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
