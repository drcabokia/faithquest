# Runtime uses the public URL/key with verified user sessions, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
FAITHQUEST_STORAGE_MODE=demo
# Keep false until development Google/session/privacy checks pass. Restart after changes.
FAITHQUEST_ACCOUNTS_ENABLED=false
FAITHQUEST_APP_ORIGIN=http://127.0.0.1:3000
# Migration tooling only, server-side, never NEXT_PUBLIC_. Use a DEVELOPMENT database.
# DATABASE_URL=
# SUPABASE_PROJECT_REF=
# FAITHQUEST_DATABASE_IS_DEVELOPMENT=false
